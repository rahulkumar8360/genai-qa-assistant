# Copy this file to .env and fill in the key. .env is ignored by git.

# Without a key the assistant runs in offline mode (extractive, no LLM).
ANTHROPIC_API_KEY=

# Optional overrides - defaults live in config.py
# QA_BACKEND=auto            # auto | claude | offline
# QA_MODEL=claude-opus-5
# QA_EFFORT=medium           # low | medium | high | xhigh | max
# QA_PROMPT_VERSION=v3       # v1 | v2 | v3
